 "<p class=\"rv-title\">{0}</p><p class=\"rv-hint\">{1}{2}</p>\n    <div class=\"pg pg-{3}\" id=\"pg\" role=\"group\" aria-label=\"{4} play area\">{5}<span class=\"pgstreak\" id=\"pgStreak\" aria-hidden=\"true\"></span><p class=\"pgmsg\" id=\"pgMsg\"></p>{6}{7}</div>\n    <div class=\"row\" style=\"width:100%;max-width:320px\"><span class=\"rv-title\" id=\"pgScore\" aria-live=\"polite\">0</span><span class=\"rv-hint\" id=\"pgTime\">{8}</span></div>\n    {9}\n    {10}\n    {11}\n    <button class=\"ghost\" id=\"pgSit\" data-cid=\"{12}\">{13}</button>": "<p class=\"rv-title\">{0}</p><p class=\"rv-hint\">{1}{2}</p>\n    <div class=\"pg pg-{3}\" id=\"pg\" role=\"group\" aria-label=\"{4}のプレイエリア\">{5}<span class=\"pgstreak\" id=\"pgStreak\" aria-hidden=\"true\"></span><p class=\"pgmsg\" id=\"pgMsg\"></p>{6}{7}</div>\n    <div class=\"row\" style=\"width:100%;max-width:320px\"><span class=\"rv-title\" id=\"pgScore\" aria-live=\"polite\">0</span><span class=\"rv-hint\" id=\"pgTime\">{8}</span></div>\n    {9}\n    {10}\n    {11}\n    <button class=\"ghost\" id=\"pgSit\" data-cid=\"{12}\">{13}</button>",
 "<button class=\"herocard\" id=\"btnShowToday\" aria-label=\"Look at today's Forgeling\">{0}</button>": "<button class=\"herocard\" id=\"btnShowToday\" aria-label=\"今日のフォージリングを見る\">{0}</button>",
 "<button class=\"herocard\" id=\"btnShowFav\" aria-label=\"Look at {0}\">{1}</button>": "<button class=\"herocard\" id=\"btnShowFav\" aria-label=\"{0}を見る\">{1}</button>",
