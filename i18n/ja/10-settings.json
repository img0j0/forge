 "<label class=\"field\"><span>A new small thing</span><input id=\"ownIn\" maxlength=\"60\" placeholder=\"For example: walk for ten minutes\" autocomplete=\"off\"></label><div class=\"lbl2\">What kind of thing is it?</div><div class=\"chips\" role=\"group\" aria-label=\"What kind of thing is it\">{0}</div><div class=\"chips\"><button class=\"pill\" id=\"ownAdd\">Add it</button></div>": "<label class=\"field\"><span>新しい小さなこと</span><input id=\"ownIn\" maxlength=\"60\" placeholder=\"例：10分歩く\" autocomplete=\"off\"></label><div class=\"lbl2\">どんな種類のことですか？</div><div class=\"chips\" role=\"group\" aria-label=\"どんな種類のことですか\">{0}</div><div class=\"chips\"><button class=\"pill\" id=\"ownAdd\">追加する</button></div>",
