 "<div class=\"row\" style=\"margin:0\"><h2 style=\"margin:0\">{0}</h2><span class=\"muted small\">{1}</span></div>\n      <div class=\"bondbar\" role=\"img\" aria-label=\"Bond progress\"><i style=\"width:{2}%\"></i></div>\n      <p class=\"muted small\">{3}</p>\n      <p class=\"small stline\">{4}</p>\n      <button class=\"rowl\" data-tale=\"{5}\" style=\"border-top:0;padding:6px 0;min-height:48px\"><span class=\"rt\"><b>{6}’s story</b><span class=\"rs\">{7} of 5 chapters{8}</span></span><span class=\"chev\" aria-hidden=\"true\">›</span></button>\n      {9}{10}{11}": "<div class=\"row\" style=\"margin:0\"><h2 style=\"margin:0\">{0}</h2><span class=\"muted small\">{1}</span></div>\n      <div class=\"bondbar\" role=\"img\" aria-label=\"絆の進み具合\"><i style=\"width:{2}%\"></i></div>\n      <p class=\"muted small\">{3}</p>\n      <p class=\"small stline\">{4}</p>\n      <button class=\"rowl\" data-tale=\"{5}\" style=\"border-top:0;padding:6px 0;min-height:48px\"><span class=\"rt\"><b>{6}の物語</b><span class=\"rs\">全5章中{7}章{8}</span></span><span class=\"chev\" aria-hidden=\"true\">›</span></button>\n      {9}{10}{11}",
